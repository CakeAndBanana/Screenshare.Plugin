<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.0.1.0</Version>
    <Description>Public and private room screen/browser sharing plugin.</Description>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>ScreenShare.Plugin</AssemblyTitle>
    <RootNamespace>ScreenShare.Plugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ScreenShare.Plugin.Tests lives as a subfolder of this project (repo self-containment for
         the separate GitHub repos) - without this, the SDK's default recursive **/*.cs glob would
         also compile the test files (and their xunit/NSubstitute-only references) straight into
         this project. -->
    <Compile Remove="ScreenShare.Plugin.Tests\**" />
    <EmbeddedResource Remove="ScreenShare.Plugin.Tests\**" />
    <None Remove="ScreenShare.Plugin.Tests\**" />

    <!-- Same reasoning for tools\: MediaProbe is a console app that lives under this project so the
         repo stays self-contained, and must not be compiled into the plugin. -->
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediaProbe soaks and benchmarks the REAL Media Foundation interop rather than a copy of it,
         so the harness cannot quietly drift from the code it is meant to be testing. -->
    <InternalsVisibleTo Include="MediaProbe" />

    <!-- So the placement round trip (matrix out, matrix back in) can be tested directly rather than
         through a copy of the same maths, which would prove nothing. -->
    <InternalsVisibleTo Include="ScreenShare.Plugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.MediaFoundation" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled directly rather than via NuGet: the only current NuGet-distributed static
         builds we found were either too old (NVENC SDK version rejected by modern drivers,
         confirmed by testing) or compiled without any hardware encoders at all. This is
         BtbN's official ffmpeg-n7.1 Windows GPL static build (ffmpeg.org-recommended source),
         confirmed working with NVENC/AMF/QSV via direct testing.

         Gitignored (132MB, over GitHub's 100MB push limit - see README for where to get it), so
         Condition="Exists(...)" keeps a fresh clone without it (e.g. CI) buildable - CI only
         needs to compile and run the unit tests, never actually launch ffmpeg. -->
    <None Include="ffmpeg\ffmpeg.exe" Condition="Exists('ffmpeg\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
